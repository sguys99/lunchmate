{
  "name": "lunchmate",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.17.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "shots": "node scripts/shots.mjs",
    "postbuild": "node scripts/check-client-secrets.mjs",
    "check:secrets": "node scripts/check-client-secrets.mjs",
    "lint:copy": "node scripts/check-copy.ts",
    "tokens": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/build-tokens.ts",
    "contrast": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/contrast-report.ts",
    "db:push": "supabase db push",
    "db:types": "node scripts/db-types.mjs",
    "db:migration:new": "supabase migration new",
    "env:sync": "node scripts/env-sync-vercel.mjs",
    "prepare": "git config core.hooksPath .githooks",
    "analyze": "next analyze --output --snapshot latest",
    "bundle:report": "node scripts/bundle-report.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@number-flow/react": "^0.6.2",
    "@sentry/nextjs": "^11.9.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.62.0",
    "motion": "^14.7.1",
    "next": "16.4.3",
    "posthog-js": "^1.438.24",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/turbopack": "^4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "eslint-config-prettier": "^10.1.8",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "shadcn": "^4.23.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.5",
    "yaml": "^2.9.1"
  }
}
