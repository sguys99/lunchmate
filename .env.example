# 런치메이트 환경변수 견본 (값 없이 키 이름만, 커밋 대상)
# 사용법: 이 파일을 .env.local로 복사한 뒤 값을 채웁니다. .env.local은 .gitignore로 커밋되지 않습니다.
# 비밀키는 채팅에 붙여넣지 말고 .env.local에 직접 넣으십시오.
# 표기: [공개] 브라우저 번들에 들어가는 키(반드시 콘솔에서 도메인 제한), [서버] 서버 함수 전용, 절대 NEXT_PUBLIC_ 금지
# 정본: CLAUDE.md 12장, 등록 절차: docs/setup-guide.md

# ── 사이트 ─────────────────────────────────────────────
# [공개] 개발 중 https://lunchmate-kr.vercel.app, 베타 전 자체 도메인으로 교체 (tasks T9.2)
NEXT_PUBLIC_SITE_URL=

# ── Supabase (Claude가 CLI로 생성 후 채움) ───────────────
# [공개] 프로젝트 URL, anon 키 (RLS로 보호)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# [서버] RLS를 우회하는 키. 서버 함수 전용
SUPABASE_SERVICE_ROLE_KEY=
# [서버] db:push, db:types용 개발 프로젝트 ID
SUPABASE_PROJECT_REF=

# ── 로그인 provider 비밀값은 여기에 없습니다 ───────────────
# 카카오(custom:kakao), 네이버(custom:naver), 구글 Client ID/Secret은 앱 코드가 쓰지 않으므로
# .env.local과 Vercel에 넣지 않고 Supabase 대시보드에 직접 입력합니다 (setup-guide 2.1절, T0.14, T0.20)

# ── 카카오 ─────────────────────────────────────────────
# [공개] JavaScript 키 (JavaScript SDK 도메인 제한 필수)
NEXT_PUBLIC_KAKAO_JS_KEY=

# ── 네이버 ─────────────────────────────────────────────
# [공개] 네이버 클라우드 Maps Client ID (Web 서비스 URL 제한 필수)
NEXT_PUBLIC_NAVER_MAP_CLIENT_ID=
# NAVER_LOGIN_CLIENT_ID / NAVER_LOGIN_CLIENT_SECRET: [서버] T0.14 대안 설계(서버 직접 구현)로 갈 때만 추가

# ── 분석, 모니터링 ─────────────────────────────────────
# [공개] PostHog 프로젝트 토큰 (phc_로 시작)
NEXT_PUBLIC_POSTHOG_KEY=
# [공개] PostHog 수집 호스트 (US https://us.i.posthog.com, EU https://eu.i.posthog.com)
NEXT_PUBLIC_POSTHOG_HOST=
# [공개 성격] Sentry DSN. 브라우저에도 노출되는 값이지만 이름은 CLAUDE.md 12장을 따름 (T0.35에서 처리 방식 확정)
SENTRY_DSN=

# ── 기능 플래그 ─────────────────────────────────────────
# [공개] true일 때만 /design-lab 노출. 프로덕션(Vercel Production)은 false
NEXT_PUBLIC_DESIGN_LAB=false
